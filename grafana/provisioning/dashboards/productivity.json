                    "kind": "DataQuery",
                    "spec": {
                      "dataset": "productivity_tracker",
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "SELECT\r\n  CASE\r\n    WHEN app_name ILIKE '%youtube%' THEN 'YouTube'\r\n    ELSE REPLACE(app_name, 'Chrome: ', '')\r\n  END AS site,\r\n  SUM(total_secs) AS duration\r\nFROM daily_stats\r\nWHERE stat_date = CURRENT_DATE\r\nAND app_name LIKE 'Chrome: %'\r\nGROUP BY 1\r\nORDER BY duration DESC\r\nLIMIT 7;",
