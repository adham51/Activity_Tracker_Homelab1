      "targets": [
        {
          "dataset": "productivity_tracker",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P84324D8F8AB6224B"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH categorized_stats AS (\r\n  SELECT\r\n    duration_secs,\r\n    CASE\r\n      -- Deep Work\r\n      WHEN app_name IN ('VS Code', 'Terminal', 'DBeaver', 'Docker', 'PyCharm', 'Cursor')\r\n        OR app_name ILIKE 'Chrome: GitHub%'\r\n        OR app_name ILIKE 'Chrome: AWS%'\r\n        OR app_name ILIKE 'Chrome: Google Cloud%'\r\n        OR app_name ILIKE 'Chrome: Codeforces%'\r\n        OR app_name ILIKE 'Chrome: Stack Overflow%'\r\n        OR app_name ILIKE 'Chrome: Grafana%'\r\n        OR app_name ILIKE 'Chrome: Mermaid%'\r\n        OR app_name ILIKE 'Chrome: Overleaf%'\r\n      THEN 'Deep Work & Coding'\r\n\r\n      -- Learning\r\n      WHEN app_name ILIKE 'Chrome: YouTube (Learning)%'\r\n        OR app_name ILIKE 'Chrome: Udemy%'\r\n        OR app_name ILIKE 'Chrome: Medium%'\r\n        OR app_name ILIKE 'Chrome: NotebookLM%'\r\n        OR app_name ILIKE 'Chrome: Claude%'\r\n        OR app_name ILIKE 'Chrome: ChatGPT%'\r\n        OR app_name ILIKE 'Chrome: Google Gemini%'\r\n        OR app_name ILIKE 'Chrome: Grafana Docs%'\r\n      THEN 'Learning & Research'\r\n\r\n      -- Career\r\n      WHEN app_name ILIKE 'Chrome: LinkedIn%'\r\n        OR app_name ILIKE 'Chrome: Wuzzuf%'\r\n        OR app_name ILIKE 'Chrome: %Jobs%'\r\n      THEN 'Career & Job Hunting'\r\n\r\n      -- Communication\r\n      WHEN app_name IN ('WhatsApp', 'Telegram', 'Discord', 'Teams', 'Zoom', 'Slack')\r\n        OR app_name ILIKE 'Chrome: Outlook%'\r\n        OR app_name ILIKE 'Chrome: Gmail%'\r\n        OR app_name ILIKE 'Chrome: Google Meet%'\r\n        OR app_name ILIKE 'Chrome: Google Drive%'\r\n        OR app_name ILIKE 'Chrome: Google Docs%'\r\n        OR app_name ILIKE 'Chrome: Google Sheets%'\r\n      THEN 'Communication'\r\n\r\n      -- Entertainment\r\n      WHEN app_name ILIKE 'Chrome: YouTube Music%'\r\n        OR app_name ILIKE 'Chrome: YouTube%'\r\n        OR app_name ILIKE 'Chrome: Facebook%'\r\n        OR app_name ILIKE 'Chrome: Instagram%'\r\n        OR app_name ILIKE 'Chrome: TikTok%'\r\n        OR app_name IN ('Spotify', 'Steam', 'League of Legends', 'VLC')\r\n      THEN 'Entertainment'\r\n\r\n      ELSE NULL\r\n    END AS category\r\n  FROM sessions\r\n  WHERE $__timeFilter(started_at)\r\n    AND app_name NOT IN ('Google Chrome', 'Firefox', 'Edge')\r\n)\r\n\r\nSELECT \r\n  category,\r\n  SUM(duration_secs) AS seconds \r\nFROM categorized_stats\r\nWHERE category IS NOT NULL\r\nGROUP BY category\r\nHAVING SUM(duration_secs) > 0\r\nORDER BY seconds ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
