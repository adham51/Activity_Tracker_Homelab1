      "targets": [
        {
          "dataset": "productivity_tracker",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P84324D8F8AB6224B"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  gs::date::timestamptz AS \"time\",\r\n  COALESCE(ROUND(SUM(d.total_secs) / 3600.0, 2), 0) AS \"Hours\"\r\nFROM generate_series(\r\n  (CURRENT_TIMESTAMP AT TIME ZONE 'Egypt')::date - INTERVAL '${lookback_days} days',\r\n  (CURRENT_TIMESTAMP AT TIME ZONE 'Egypt')::date,\r\n  '1 day'\r\n) AS gs\r\nLEFT JOIN daily_stats d\r\n  ON d.stat_date = gs::date\r\n  AND d.app_name NOT LIKE 'Chrome: %'\r\nGROUP BY gs\r\nORDER BY gs ASC;",
          "refId": "A",
          "sql": {
