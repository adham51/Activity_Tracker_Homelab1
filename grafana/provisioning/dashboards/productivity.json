    "panel-5": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "P84324D8F8AB6224B"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "dataset": "productivity_tracker",
                      "editorMode": "code",
                      "format": "time_series",
                      "rawQuery": true,
                      "rawSql": "SELECT\r\n  gs::date::timestamptz AS \"time\",\r\n  COALESCE(ROUND(SUM(d.total_secs) / 3600.0, 2), 0) AS \"Hours\"\r\nFROM generate_series(\r\n  date_trunc('day', NOW()),\r\n  date_trunc('day', NOW()) + INTERVAL '6 days',\r\n  '1 day'\r\n) AS gs\r\nLEFT JOIN daily_stats d\r\n  ON d.stat_date = gs::date\r\n  AND d.app_name NOT LIKE 'Chrome: %'\r\nGROUP BY gs\r\nORDER BY gs ASC",
                      "sql": {
                        "columns": [
                          {
                            "parameters": [],
                            "type": "function"
                          }
                        ],
                        "groupBy": [
